<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Pravadh DocSign</masterLabel>
    <description>Generate documents and send them for signature from any record page (any standard or custom object).</description>
    <targets>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__RecordPage">
            <property name="cardTitle" type="String" label="Card title" default="Pravadh DocSign"/>
            <property name="showDocuments" type="Boolean" label="Expand document list by default" default="true"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
