/**
 * Pravadh DocSign - Salesforce Files storage for user-initiated work (document generation).
 * All documents live in native Salesforce Files linked to the DocSign record and (optionally)
 * to the originating business record. Runs with sharing and user-mode DML only; the files written
 * during finalization after the last external signer are saved by DocSignCompletionService.
 */
public with sharing class DocSignFileService {
    public class SavedFile {
        public Id versionId;
        public Id contentDocumentId;
    }

    public static SavedFile save(String title, String fileName, Blob data, Id firstPublishLocationId, Set<Id> linkTo) {
        ContentVersion cv = new ContentVersion(
            Title = title.left(255),
            PathOnClient = sanitize(fileName),
            VersionData = data,
            FirstPublishLocationId = firstPublishLocationId,
            Description = 'Generated by Pravadh DocSign'
        );
        insert as user cv;
        cv = [SELECT Id, ContentDocumentId FROM ContentVersion WHERE Id = :cv.Id WITH USER_MODE LIMIT 1];
        SavedFile sf = new SavedFile();
        sf.versionId = cv.Id;
        sf.contentDocumentId = cv.ContentDocumentId;
        List<ContentDocumentLink> links = linksFor(cv.ContentDocumentId, firstPublishLocationId, linkTo);
        if (!links.isEmpty()) {
            // Some objects do not support Files; linking failures must not block generation.
            Database.insert(links, false, AccessLevel.USER_MODE);
        }
        return sf;
    }

    /** Additional ContentDocumentLinks for a new file (skips the record it was published to). */
    public static List<ContentDocumentLink> linksFor(Id contentDocumentId, Id firstPublishLocationId, Set<Id> linkTo) {
        List<ContentDocumentLink> links = new List<ContentDocumentLink>();
        if (linkTo != null) {
            for (Id target : linkTo) {
                if (target != null && target != firstPublishLocationId) {
                    links.add(new ContentDocumentLink(ContentDocumentId = contentDocumentId, LinkedEntityId = target, ShareType = 'I', Visibility = 'AllUsers'));
                }
            }
        }
        return links;
    }

    public static String sanitize(String fileName) {
        String f = String.isBlank(fileName) ? 'Document' : fileName;
        f = f.replaceAll('[\\\\/:*?"<>|\\r\\n\\t]', ' ').normalizeSpace();
        return f.left(250);
    }

    public static String downloadUrl(Id versionId) {
        return versionId == null ? null : '/sfc/servlet.shepherd/version/download/' + versionId;
    }

    public static String viewUrl(Id contentDocumentId) {
        return contentDocumentId == null ? null : '/lightning/r/ContentDocument/' + contentDocumentId + '/view';
    }
}
