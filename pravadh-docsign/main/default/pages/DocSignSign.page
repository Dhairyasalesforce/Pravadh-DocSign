      function alertInline(t) { var h = document.getElementById('sigTitle'); h.textContent = t; h.style.color = '#c62828'; setTimeout(function () { h.style.color = ''; }, 1800); }

      // ---------- decline
      var dm = document.getElementById('declineModal');
      document.getElementById('declineOpen').addEventListener('click', function () { dm.classList.add('open'); });
      document.getElementById('declineCancel').addEventListener('click', function () { dm.classList.remove('open'); });

      // ---------- finish
      consent.addEventListener('change', function () { updateProgress(); });
